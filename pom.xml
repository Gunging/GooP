<?xml version="1.0" encoding="UTF-8"?>
<!--
  GooP 2.x build.

  One shared Bukkit source tree (goop-common/) is compiled twice:
    goop-legacy  -> Paper/Purpur 1.20.1 - 1.20.6     (Java 17 bytecode)
    goop-modern  -> Paper/Purpur 1.21.1 - 26.x       (Java 21 bytecode)
  Compiling the same source against each API generation gives correct bytecode for both
  (for example InventoryView is a class before 1.21 and an interface after), without
  maintaining two copies of the code. Differences that the source itself cannot paper over
  live in each edition's src/edition/java.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>gunging.ootilities</groupId>
    <artifactId>goop-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Gunging Ootilities Plugin (parent)</name>
    <url>https://github.com/Gunging/GooP</url>

    <licenses>
        <license>
            <name>CC0 1.0 Universal</name>
            <url>https://creativecommons.org/publicdomain/zero/1.0/</url>
        </license>
    </licenses>

    <modules>
        <module>goop-core</module>
        <module>editions</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        

        <!-- Third-party APIs shared by both editions -->
        <mmoitems.version>6.10.1-SNAPSHOT</mmoitems.version>
        <mythiclib.version>1.7.1-SNAPSHOT</mythiclib.version>
        <mmocore.version>1.13.1-SNAPSHOT</mmocore.version>
        <crucible.version>2.2.0</crucible.version>
        <worldguard.version>7.0.9</worldguard.version>
        <worldedit.version>7.2.15</worldedit.version>
        <placeholderapi.version>2.11.6</placeholderapi.version>
        <vault.version>1.7.1</vault.version>
        <discordsrv.version>1.28.0</discordsrv.version>
        <essentials.version>2.20.1</essentials.version>
        <griefprevention.version>16.18.4</griefprevention.version>
        <mcmmo.version>2.2.000</mcmmo.version>
        <cmi.version>9.8.6.4</cmi.version>
        <cmilib.version>1.6.0.4</cmilib.version>
        <exp4j.version>0.4.8</exp4j.version>
        <annotations.version>24.1.0</annotations.version>
        <junit.version>5.11.3</junit.version>
    </properties>

    <repositories>
        <repository><id>papermc</id><url>https://repo.papermc.io/repository/maven-public/</url></repository>
        <repository><id>phoenix</id><url>https://nexus.phoenixdevt.fr/repository/maven-public/</url></repository>
        <repository><id>lumine</id><url>https://mvn.lumine.io/repository/maven-public/</url></repository>
        <repository><id>enginehub</id><url>https://maven.enginehub.org/repo/</url></repository>
        <repository><id>placeholderapi</id><url>https://repo.extendedclip.com/releases/</url></repository>
        <repository><id>scarsz</id><url>https://nexus.scarsz.me/content/groups/public/</url></repository>
        <repository><id>essentialsx</id><url>https://repo.essentialsx.net/releases/</url></repository>
        <repository><id>neetgames</id><url>https://nexus.neetgames.com/repository/maven-public/</url></repository>
        <repository><id>jitpack</id><url>https://jitpack.io</url></repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>gunging.ootilities</groupId>
                <artifactId>goop-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains</groupId>
                <artifactId>annotations</artifactId>
                <version>${annotations.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
